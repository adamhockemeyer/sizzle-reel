# Node / npm
node_modules/
package-lock.json
npm-debug.log*

# Skill output artifacts (generated when running the pipeline, not part of the skill).
frames/
out/
*.mp4
*.gif
*-poster.png
*-palette.png

# ...but the curated example reels under examples/ ARE committed (showcase media).
# They live at the repo root and are never shipped into a user's skill install
# (only skills/sizzle-reel/ is installed by `npx skills add` / a manual copy).
!examples/**/*.mp4
!examples/**/*.gif
!examples/**/*-poster.png

# Vendored libs are fetched per-project, not committed here
vendor/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
